# clinic.pack — a small third worked example: a clinic front desk.

pack clinic {
  name: "clinic",
  version: "0.1.0",
  description: "Clinic front-desk pack: doctor search, appointments, rescheduling.",
  author: "Habib Ur Rehman",
  tools: ["doctors_search", "appointment_book", "appointment_reschedule", "appointment_cancel"],
}

schema SpecialtyRequest {
  specialty: string,
  day: string?,
}

schema Doctor {
  name: string,
  specialty: string,
  days: list[string],
}

schema DoctorList {
  doctors: list[Doctor],
}

schema AppointmentRequest {
  doctor: string,
  day: string,
  time: string,
  patient_name: string,
  phone: string,
}

schema Appointment {
  appointment_id: string,
  doctor: string,
  day: string,
  time: string,
  status: enum { confirmed, waitlisted },
}

schema AppointmentRef {
  appointment_id: string?,
}

schema RescheduleRequest {
  appointment_id: string?,
  new_day: string,
  new_time: string,
}

schema RescheduleResult {
  appointment_id: string,
  new_day: string,
  new_time: string,
}

schema CancelOutcome {
  cancelled: bool,
}

schema ClinicContext {
  is_emergency: bool = false,
}

skill find-doctor {
  description: "Find doctors by specialty and day.",
  trigger: ["find a doctor", "cardiologist available", "doctor on monday"],
  input: SpecialtyRequest,
  output: DoctorList,
  tool: "doctors_search",
  steps: [
    "Parse the specialty and optional day.",
    "Search the roster for matching doctors.",
    "Reply with names and their available days.",
  ],
}

skill book-appointment {
  description: "Book an appointment with a named doctor.",
  trigger: ["book an appointment", "see dr ahmed tomorrow"],
  input: AppointmentRequest,
  output: Appointment,
  tool: "appointment_book",
  steps: [
    "Verify the doctor has a free slot at the requested time.",
    "Create the appointment and journal it.",
    "Reply with the appointment ID and arrival instructions.",
  ],
}

skill reschedule-appointment {
  description: "Move an appointment to a new day and time.",
  trigger: ["move my appointment", "reschedule visit"],
  input: RescheduleRequest,
  output: RescheduleResult,
  tool: "appointment_reschedule",
  steps: [
    "Look up the appointment by ID or phone number.",
    "Verify the new slot is free with the same doctor.",
    "Update the appointment and confirm the new slot.",
  ],
}

skill cancel-appointment {
  description: "Cancel an appointment.",
  trigger: ["cancel my appointment", "cannot come tomorrow"],
  input: AppointmentRef,
  output: CancelOutcome,
  tool: "appointment_cancel",
  steps: [
    "Look up the appointment by ID or phone number.",
    "Cancel it and release the slot.",
    "Confirm the cancellation.",
  ],
}

flow care {
  start: find-doctor,
  on found -> book-appointment,
  on none -> find-doctor,
}

escalate {
  context: ClinicContext,
  defaults: {
    "message.send": auto,
    "appointment.book": confirm,
    "appointment.cancel": confirm,
  },
  rule emergency: when is_emergency == true -> tier: human_only,
  rule fallback: -> tier: confirm,
}
