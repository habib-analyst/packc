pack synth {
  name: "synth",
  version: "0.1.0",
  description: "synthetic corpus pack",
  author: "packc",
  tools: ["tool_0", "tool_1", "tool_2", "tool_3", "tool_4", "tool_5", "tool_6", "tool_7", "tool_8", "tool_9", "tool_10", "tool_11", "tool_12", "tool_13", "tool_14", "tool_15", "tool_16", "tool_17", "tool_18", "tool_19", "tool_20", "tool_21", "tool_22", "tool_23", "tool_24", "tool_25", "tool_26", "tool_27", "tool_28", "tool_29"],
}

schema S0 {
  f0: int,
  f1: float,
  f2: float,
  f3: int = 1,
}

schema S1 {
  f0: float,
  f1: string,
  f2: string,
  f3: bool,
}

schema S2 {
  f0: string,
  f1: float,
  f2: float,
  f3: enum { a, b, c }?,
}

schema S3 {
  f0: float,
  f1: string,
  f2: list[string],
  f3: bool,
}

schema S4 {
  f0: enum { a, b, c }?,
  f1: string,
  f2: bool,
  f3: string,
}

schema S5 {
  f0: enum { a, b, c }?,
  f1: float,
  f2: list[string],
  f3: enum { a, b, c }?,
}

schema S6 {
  f0: float,
  f1: enum { a, b, c }?,
  f2: int,
  f3: string,
}

schema S7 {
  f0: list[string],
  f1: int,
  f2: string,
  f3: int,
}

schema S8 {
  f0: bool,
  f1: float,
  f2: bool,
  f3: list[string],
}

schema S9 {
  f0: float,
  f1: int = 1,
  f2: int,
  f3: list[string],
}

schema S10 {
  f0: list[string],
  f1: list[string],
  f2: string,
  f3: enum { a, b, c }?,
}

schema S11 {
  f0: list[string],
  f1: int,
  f2: int = 1,
  f3: bool,
}

schema Ctx {
  amount_pkr: int = 0,
}

