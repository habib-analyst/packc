# restaurant.pack — a small second worked example: table booking for a restaurant.

pack restaurant {
  name: "restaurant",
  version: "0.2.0",
  description: "Restaurant front-of-house pack: table availability, reservations, menu.",
  author: "Habib Ur Rehman",
  tools: ["tables_available", "table_reserve", "menu_fetch", "reservation_cancel"],
}

schema PartyRequest {
  date: string,
  time: string,
  party_size: int = 2,
  name: string?,
}

schema TableOption {
  table_id: string,
  seats: int,
  area: enum { indoor, outdoor, rooftop },
}

schema TableAvailability {
  date: string,
  time: string,
  options: list[TableOption],
}

schema ReservationRequest {
  date: string,
  time: string,
  table_id: string,
  name: string,
  phone: string,
  party_size: int = 2,
}

schema Reservation {
  reservation_id: string,
  table_id: string,
  status: enum { confirmed, waitlisted },
}

schema ReservationRef {
  reservation_id: string?,
}

schema CancelOutcome {
  cancelled: bool,
}

schema MenuRequest {
  category: enum { starter, main, dessert, drink }?,
}

schema MenuItem {
  name: string,
  price_pkr: int,
  category: enum { starter, main, dessert, drink },
}

schema Menu {
  items: list[MenuItem],
}

schema DiningContext {
  party_size: int = 2,
  amount_pkr: int = 0,
}

skill check-table {
  description: "Check which tables are free for a date and time.",
  trigger: ["table available", "book a table", "free table tonight"],
  input: PartyRequest,
  output: TableAvailability,
  tool: "tables_available",
  steps: [
    "Parse date, time, and party size from the message.",
    "Query free tables that seat the party.",
    "Reply with the options grouped by area.",
  ],
}

skill reserve-table {
  description: "Reserve a chosen table.",
  trigger: ["reserve this table", "confirm my reservation"],
  input: ReservationRequest,
  output: Reservation,
  tool: "table_reserve",
  steps: [
    "Verify the table is still free for the slot.",
    "Create the reservation and journal it.",
    "Reply with the reservation ID.",
  ],
}

skill view-menu {
  description: "Show the menu, optionally filtered by category.",
  trigger: ["show me the menu", "what desserts do you have"],
  input: MenuRequest,
  output: Menu,
  tool: "menu_fetch",
  steps: [
    "Fetch the current menu from the property profile.",
    "Filter by category when one was named.",
    "Reply with names and PKR prices.",
  ],
}

skill cancel-reservation {
  description: "Cancel a table reservation.",
  trigger: ["cancel my table", "cancel reservation"],
  input: ReservationRef,
  output: CancelOutcome,
  tool: "reservation_cancel",
  steps: [
    "Look up the reservation by ID or phone number.",
    "Cancel it and free the table.",
    "Confirm the cancellation.",
  ],
}

flow dining {
  start: check-table,
  on table_found -> reserve-table,
  on none_free -> check-table,
}

escalate {
  context: DiningContext,
  defaults: {
    "message.send": auto,
    "table.reserve": auto,
    "reservation.cancel": confirm,
  },
  rule large_party: when party_size > 8 -> tier: confirm,
  rule fallback: -> tier: auto,
}
